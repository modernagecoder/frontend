  "program_overview": {
    "title": "Data Structures & Algorithms Masterclass",
    "tagline": "The skill every serious coding interview tests, built the only way it sticks: patterns understood, hundreds of problems solved, explained out loud under time.",
    "description": "DSA is the great filter of technical hiring: the same topics appear in every serious interview, and the gap between having seen a problem and being able to solve a new one live is exactly what interviewers probe. This live online masterclass closes that gap the honest way, no memorized solution lists. It builds the full canon in order: complexity analysis and linear structures, searching, sorting and hashing, trees, heaps and graphs, then the hard middle, shortest paths, network flow, dynamic programming to real depth, greedy and backtracking, then interview mastery: company-style problem sets, timed simulations, and explaining your reasoning aloud the way the room demands. A finale month runs a mock-interview gauntlet and sits the final exam.\n\nThe pace is honest: ten teaching months at two live classes a week plus four to six hours of problem-solving, with two more in hand. Problem sets after every class, monthly mixed reviews, phase exams, and a final exam that decides the certificate with a free retest.",
    "what_makes_this_different": [
      "Patterns, not memorization: you learn to solve unseen problems, which is the actual test",
      "Explaining aloud is trained, not assumed: interviews score communication too",
      "Dynamic programming taught until it clicks, the topic that breaks most candidates",
      "Company-style problem sets and timed mock interviews, honestly framed as practice",
      "An honest 10-month arc with 2 months in hand",
      "Real assessment: weekly problem sets, monthly mixed reviews, phase exams and a final exam with a free retest"
    ],
    "learning_path": {
      "phase_1": "Core structures (Months 1-3): complexity, arrays to trees, heaps and hashing",
      "phase_2": "Hard algorithms (Months 4-6): graphs, shortest paths, dynamic programming, greedy and backtracking",
      "phase_3": "Interview mastery (Months 7-9): company-style sets, timed simulations, communication",
      "phase_4": "The finale (Month 10): a mock-interview gauntlet and the final exam"
    },
    "career_outcomes": [
      "The single most-tested skill in technical hiring, owned at depth",
      "The ability to solve unseen problems live, not recite seen ones",
      "A solved-problem portfolio across every major pattern",
      "Honest next roads: placements, competitive programming, or system design"
    ]
