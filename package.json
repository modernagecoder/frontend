{
  "name": "modern-age-coders-frontend",
  "version": "1.0.0",
  "description": "Frontend for Modern Age Coders",
  "scripts": {
    "pricing:check": "node scripts/pricing/check.js",
    "pricing:preview": "node scripts/pricing/apply.js --dry-run",
    "pricing:apply": "node scripts/pricing/apply.js",
    "pricing:verify": "node scripts/pricing/verify.js",
    "kb:build": "python scripts/kb/build_appendices.py",
    "kb:pdf": "python scripts/kb/make_pdf.py",
    "kb:verify": "python scripts/kb/verify_pdf.py && python scripts/kb/verify_completeness.py",
    "kb": "npm run kb:build && npm run kb:pdf && npm run kb:verify",
    "kb:agent": "python scripts/kb/build_agent_text.py && python scripts/kb/verify_agent_text.py && python scripts/kb/make_agent_pdf.py",
    "generate:blogs": "node scripts/generate-blogs.js",
    "generate:courses": "node scripts/generate-courses.js",
    "generate:resources": "node scripts/generate-resources.js",
    "generate:static-md": "node scripts/generate-static-md.js",
    "generate:llms": "node scripts/generate-llms-full.js",
    "generate:sitemap-html": "node scripts/generate-sitemap-html.js",
    "generate:sitemap-index": "node scripts/generate-sitemap-index.js",
    "verify:sitemap": "node scripts/verify-sitemap.js",
    "indexnow": "node scripts/indexnow-ping.js",
    "generate:all": "npm run generate:html && npm run pricing:apply && npm run generate:derived",
    "update:course-links": "node scripts/update-course-links.js",
    "build:links": "node scripts/build-internal-links.js",
    "dev": "node scripts/dev-server.js",
    "start": "node scripts/dev-server.js",
    "test:contrast": "node scripts/contrast-checker.js",
    "test:typography": "node scripts/mobile-typography-test.js",
    "validate:viewport": "node scripts/viewport-validator.js",
    "validate:headings": "node scripts/validate-heading-hierarchy.js",
    "test:performance": "node scripts/simple-performance-test.js",
    "build:inline": "node scripts/inline-components.js",
    "build:core-css": "node scripts/build-core-css.js",
    "minify": "node scripts/minify.js",
    "pricing:test": "node scripts/pricing/test-stamp.js && node scripts/pricing/test-rendered.js && node scripts/pricing/test-phone.js",
    "pricing:tag": "node scripts/pricing/tag.js",
    "generate:html": "npm run generate:blogs && npm run generate:courses && npm run generate:resources",
    "generate:derived": "npm run generate:static-md && npm run generate:llms && npm run generate:sitemap-html && npm run generate:sitemap-index && npm run verify:sitemap"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "clean-css": "^5.3.3",
    "dotenv": "^16.3.1",
    "firebase-admin": "^11.11.0",
    "jsdom": "^23.0.0",
    "sharp": "^0.34.5",
    "terser": "^5.46.1"
  },
  "keywords": [
    "education",
    "frontend"
  ],
  "author": "Modern Age Coders",
  "license": "MIT"
}
