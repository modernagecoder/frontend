// ═══════════════════════════════════════════════════════════════════════════
//  MODERN AGE CODERS — THE ONLY FILE YOU EDIT TO CHANGE A PRICE
// ═══════════════════════════════════════════════════════════════════════════
//
//  Change a number here, run  npm run pricing:apply , and it updates every
//  page on the site — visible prices, Google's structured data, the .md files
//  AI engines read, and the amount Razorpay actually charges.
//
//  Read pricing/README.md before your first edit. The three commands are:
//
//    npm run pricing:check     tells you if this file is valid  (do this first)
//    npm run pricing:preview   shows exactly what would change, changes nothing
//    npm run pricing:apply     writes the change into every page
//
//  Comments are allowed in this file (it is .jsonc). Trailing commas are not.
//
// ═══════════════════════════════════════════════════════════════════════════
{
  "version": 1,
  "updated": "2026-07-31",

  // ───────────────────────────────────────────────────────────────────────
  //  1. THE PRICES
  // ───────────────────────────────────────────────────────────────────────
  //
  //  Every price on the site is named  subject.region.tier  — for example
  //  coding.india.group  is the ₹1,499 figure.
  //
  //  null  means "we do not sell this".  The build refuses to print a price
  //  for it and hides that plan from those visitors. Never put a number in a
  //  null slot unless you genuinely intend to start selling it.
  //
  //  india        = amounts in ₹ INR, charged by Razorpay domestic
  //  international= amounts in $ USD. These are the LIST prices. Visitors in
  //                 lower-income countries pay less, worked out automatically
  //                 from the worldwide.* settings in section 3.
  //
  "plans": {

    "coding": {
      "india":         { "group": 1499, "miniBatch": 2499, "personal": 4999, "lifetime": 49999 },
      "international": { "group": 40,   "miniBatch": null, "personal": 100,  "lifetime": 599 }
    },

    // Maths currently costs the same as coding inside India. It is listed
    // separately on purpose, so you can change one without touching the other.
    "maths": {
      "india":         { "group": 1499, "miniBatch": 2499, "personal": 4999, "lifetime": null },
      "international": { "group": 100,  "miniBatch": null, "personal": 150,  "lifetime": null }
    },

    // The premium Codex + Claude Code courses. Students run the real paid
    // agent tools on their own Claude / ChatGPT subscriptions, so these are
    // priced above everything else. Applied via courseOverrides below.
    "agents": {
      "india":         { "group": 2499, "miniBatch": 4999, "personal": 9999, "lifetime": null },
      "international": { "group": 100,  "miniBatch": null, "personal": 150,  "lifetime": null }
    },

    // In-school bootcamp programmes (CBSE CS Practical, Informatics Practices,
    // ISC CS Practical, Girls in Tech). These prices are already published
    // inside FAQ structured data on the school pages.
    "school": {
      "india":         { "group": 1999, "miniBatch": null, "personal": 2999, "lifetime": null },
      "international": { "group": null, "miniBatch": null, "personal": null, "lifetime": null }
    },

    // Holiday camps. One payment, not monthly — so the tier is "oneTime".
    "camps": {
      "india":         { "oneTime": 4999 },
      "international": { "oneTime": 60 }
    }
  },

  // ───────────────────────────────────────────────────────────────────────
  //  2. INDIVIDUAL COURSES THAT ARE PRICED DIFFERENTLY
  // ───────────────────────────────────────────────────────────────────────
  //
  //  By default every course uses the "coding" prices. List a course slug
  //  here to move it onto a different price set. Add a line, run apply, done —
  //  no code change needed.
  //
  "courseOverrides": {
    "codex-and-claude-code-ai-coding-agents-course-for-teens":                  "agents",
    "codex-and-claude-code-ai-coding-agents-masterclass-for-adults-professionals": "agents"
  },

  // ───────────────────────────────────────────────────────────────────────
  //  3. WORLDWIDE PRICING (purchasing power parity)
  // ───────────────────────────────────────────────────────────────────────
  //
  //  A family in Lagos earns very differently from a family in Oslo, so the
  //  same $40 does not feel the same. These settings work out a fair price
  //  per country automatically, from live World Bank data.
  //
  //  THE ONE RULE THAT PROTECTS YOU: no country is ever charged less, after
  //  fees, than an Indian student pays you. That is the "floor" below.
  //  Without it, real World Bank data puts 81 of 208 countries BELOW your
  //  Indian price — you would earn less from Lagos than from Kolkata for the
  //  same live teacher.
  //
  "worldwide": {

    // Turn the whole worldwide layer on or off. When false, every visitor
    // outside India simply sees the international list price above, exactly
    // as the site behaved before this system existed.
    "enabled": true,

    // How strongly to follow purchasing power. 1.0 = follow it exactly
    // (too deep — see the note above). 0 = ignore it, everyone pays list.
    // 0.57 gives roughly the same relationship your ₹1,499 and $40 already
    // have to each other today.
    "dampingExponent": 0.57,

    // Never discount more than this, whatever the data says.
    "maxDiscountPercent": 60,

    // Never charge MORE than the list price. Set to a number above 100 if you
    // ever decide high-income countries should pay a premium (110 = up to +10%).
    "maxPremiumPercent": 100,

    // The floor. Your protection against ever earning less abroad than at home.
    "floor": {
      // Which India price each international plan must not undercut.
      // EVERY tier you sell needs a line here. A tier missing from this list
      // gets no floor at all and can be discounted below what India nets you.
      "matchIndiaTier": {
        "group":     "group",
        "miniBatch": "miniBatch",
        "personal":  "personal",
        "lifetime":  "lifetime",
        "oneTime":   "oneTime"
      },
      // Extra safety margin on top, in percent. Raise this if you want more cushion.
      "safetyMarginPercent": 0
    },

    // What it costs you to collect the money. Used to work out the floor, so
    // that "not less than India" means after fees, not before them.
    "costs": {
      "domesticGatewayPercent":      2.0,   // Razorpay domestic — published rate
      "internationalGatewayPercent": 3.0,   // Razorpay international — published ceiling
      "gstOnGatewayFeePercent":      18.0,  // published
      "fxSpreadBufferPercent":       3.0,   // ASSUMPTION — Razorpay does not publish its card FX spread
      "gstOnServicePercent":         0.0    // 0 assumes zero-rated export under LUT. ASK YOUR CA.
                                            // If it is really 18, put 18 here and the floor rises ~22%.
    },

    // How the final number is tidied up. "charm" turns 17.42 into 17.99.
    "rounding": "charm",

    // Countries whose currency moves too fast to quote safely. These visitors
    // see the US dollar price only, with no local-currency estimate.
    "unstableCurrencies": ["ARS", "TRY", "VES", "LBP", "SSP", "ZWL"],

    // Ignore World Bank figures older than this many years and charge list
    // price instead, rather than quietly using a 15-year-old price level.
    "maxDataAgeYears": 3,

    // Visitors we cannot place, and anyone in India, get this.
    "defaultRegion": "india"
  },

  // ───────────────────────────────────────────────────────────────────────
  //  4. HOW PRICES ARE WRITTEN OUT
  // ───────────────────────────────────────────────────────────────────────
  "display": {
    // The currency actually charged. Local currencies are shown as a clearly
    // labelled estimate next to it, never instead of it.
    "chargeCurrencies": { "india": "INR", "international": "USD" },

    // Wording used when a price is written in full.
    "periodLabels": { "monthly": "/month", "oneTime": "" },

    // Live classes included per month. Used to work out the "per class" and
    // "per hour" figures that appear on some pages, so they are recalculated
    // rather than left behind when a price changes.
    "classesPerMonth": 8,
    "hoursPerClass": 1
  },

  // ───────────────────────────────────────────────────────────────────────
  //  5. THINGS THE CHECKER MUST IGNORE
  // ───────────────────────────────────────────────────────────────────────
  //
  //  Numbers that look like prices but are not. Without this list the verifier
  //  would flag lesson content and CSS as broken prices.
  //
  "allowlist": {
    // Files where any price-looking number is intentional and must be left alone.
    "files": [
      "src/pages/coding-fee-calculator.html",   // owns its own subject × age price matrix
      "content/courses/data/*.json",            // lesson content: SQL rows, quiz answers
      "src/pages/*sql*.html",
      "src/pages/*quiz*.html"
    ],
    // Text patterns that are never a price of ours.
    "patterns": [
      "z-index",           // z-index: 9999
      "border-radius",     // border-radius: 9999px
      "9999px",
      "competitor",        // market-rate comparisons quoted from others
      "exam fee",          // third-party exam fees
      "prize"              // hackathon prize money
    ]
  }
}
